{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stair-ai.com/schemas/records.schema.json",
  "title": "Reasoning Ledger Record Schemas",
  "description": "Canonical record schemas for the Reasoning Ledger. Prose reference: SCHEMA.md.",
  "version": "0.5",
  "retired_versions": [
    "1.0"
  ],
  "$defs": {
    "BehaviorType": {
      "type": "string",
      "enum": [
        "Observing",
        "ToolCalling",
        "Planning",
        "Thinking",
        "Acting",
        "Reflecting",
        "Attesting",
        "Escalating",
        "Delegating",
        "Memorizing",
        "Other"
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid"
    },
    "EpochMs": {
      "type": "integer",
      "minimum": 0
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ContentRef": {
      "type": "object",
      "description": "Reference to raw content held in the content library. Raw text never goes into a record: upload the bytes first, then reference them.",
      "required": [
        "sha256",
        "bytes",
        "media_type"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256Hex",
          "description": "SHA-256 of the raw bytes, lowercase hex."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "text/plain; charset=utf-8",
            "application/json"
          ]
        }
      },
      "additionalProperties": false
    },
    "Executor": {
      "type": "string",
      "enum": [
        "ai",
        "det",
        "human"
      ],
      "description": "Who performed the step: a model (ai), deterministic code (det) or a person (human)."
    },
    "RecordPhase": {
      "type": "string",
      "enum": [
        "pre_execution",
        "concurrent",
        "post_execution"
      ],
      "description": "When the record was written relative to the action it describes."
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "denied",
        "escalated",
        "timeout",
        "cancelled"
      ]
    },
    "SourceDescriptor": {
      "type": "object",
      "description": "Where an input came from. Only kind and ref are required; other fields are open.",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "model",
            "rule",
            "reference_data",
            "api",
            "document",
            "human",
            "record"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Stable reference to the source."
        },
        "fetched_at": {
          "$ref": "#/$defs/EpochMs"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex",
          "description": "Content hash of what was fetched."
        }
      },
      "additionalProperties": true
    },
    "DecidedBy": {
      "type": "string",
      "enum": [
        "human",
        "model",
        "rule",
        "policy",
        "classifier",
        "config",
        "consensus"
      ],
      "description": "Who or what made the judgment. Machine approvals (config, policy, classifier) are recorded here on the record they decided, never as an Attesting record."
    },
    "Verdict": {
      "type": "object",
      "description": "Basis of a judgment. Only conclusion and decided_by are required; other fields are open.",
      "required": [
        "conclusion",
        "decided_by"
      ],
      "properties": {
        "conclusion": {
          "description": "The judgment itself (any JSON value)."
        },
        "decided_by": {
          "$ref": "#/$defs/DecidedBy"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "rule_ref": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "WrittenBy": {
      "type": "object",
      "description": "Declared by the submitter: which component wrote the record, with which credential. A record, not a permission.",
      "required": [
        "component",
        "credential"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Classification": {
      "type": "object",
      "description": "How the record came to carry its behavior: declared by the instrumented writer, inferred by a rule, judged by a model or labelled by a person.",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "instrumented",
            "rule",
            "judge",
            "human"
          ]
        },
        "mapper": {
          "type": "string",
          "minLength": 1,
          "description": "Name and version of the writer or mapper, e.g. 'collector@0.3'."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "behavior",
              "confidence"
            ],
            "properties": {
              "behavior": {
                "$ref": "#/$defs/BehaviorType"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "maxItems": 8
        }
      },
      "additionalProperties": false
    },
    "ModelInvocation": {
      "type": "object",
      "required": [
        "provider",
        "model_name"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Null is meaningful only when invocation_kind is replay or simulated; the schema does not enforce this."
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Null is meaningful only when invocation_kind is replay or simulated; the schema does not enforce this."
        },
        "invocation_kind": {
          "type": "string",
          "enum": [
            "live",
            "replay",
            "cached",
            "simulated"
          ],
          "description": "live = a real call; replay = a recorded response played back; cached = served from a cache; simulated = produced without a model."
        },
        "replay_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "$ref": "#/$defs/ContentRef"
            }
          ],
          "description": "The record or content a replay reproduces."
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "temperature": {
          "type": "number",
          "description": "Only callers that set it themselves can fill this."
        },
        "finish_reason": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "The provider's request id, for reconciliation with provider logs."
        },
        "internal_reasoning": {
          "$ref": "#/$defs/ContentRef",
          "description": "Raw internal reasoning / chain-of-thought emitted by the foundation model alongside (and distinct from) its final output, stored in the content library. Maps to provider-specific reasoning channels, e.g. DeepSeek 'reasoning_content', OpenAI o-series reasoning summaries, Anthropic extended-thinking blocks, Gemini thoughts. Distinct from the SDK 'Thinking' behavior, which records a deliberate agent thinking step."
        }
      },
      "additionalProperties": false
    },
    "BaseRecord": {
      "type": "object",
      "required": [
        "schema_version",
        "agent_id",
        "session_id",
        "record_id",
        "behavior",
        "client_ts_utc",
        "executor",
        "record_phase"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "0.5"
          ]
        },
        "agent_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "behavior": {
          "$ref": "#/$defs/BehaviorType"
        },
        "client_ts_utc": {
          "$ref": "#/$defs/EpochMs"
        },
        "notes": {
          "type": "string",
          "maxLength": 2048
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 32
        },
        "model_invocation": {
          "$ref": "#/$defs/ModelInvocation"
        },
        "upstream_record_id": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          },
          "maxItems": 32,
          "description": "DAG dependency / trace sequence. Records this one builds on. May be empty/omitted. An Attesting record lists the Escalating record it answers here."
        },
        "executor": {
          "$ref": "#/$defs/Executor"
        },
        "record_phase": {
          "$ref": "#/$defs/RecordPhase"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "On Attesting and Escalating: how long the pending item waited for a person."
        },
        "error_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Low-cardinality error class when outcome is failure, timeout, denied or cancelled, e.g. tool.not_found, permission.denied, http.5xx, validation.rejected, user.abort."
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceDescriptor"
          },
          "maxItems": 64
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "written_by": {
          "$ref": "#/$defs/WrittenBy",
          "description": "Which program wrote the record and with what credential. Required on Attesting, recommended everywhere else."
        },
        "on_behalf_of_agent_id": {
          "$ref": "#/$defs/UuidV4",
          "description": "Set when the writer is not the agent whose behavior this is, e.g. a platform recording a fill or a settlement for an agent."
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        }
      }
    },
    "ThinkingInput": {
      "type": "object",
      "required": [
        "input_payload"
      ],
      "properties": {
        "input_record_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "input_payload": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "additionalProperties": false
    },
    "ReflectingInput": {
      "type": "object",
      "required": [
        "input_payload"
      ],
      "properties": {
        "input_record_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "input_payload": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "additionalProperties": false
    },
    "PlanningStep": {
      "type": "object",
      "required": [
        "index",
        "description"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "ToolMeta": {
      "type": "object",
      "description": "Which tool was called. Only name is required; unknown keys are allowed.",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "call_id": {
          "type": "string",
          "minLength": 1,
          "description": "The harness's own id for this call (OTel gen_ai.tool.call.id, ATIF tool_call_id, Claude Code tool_use_id)."
        },
        "tool_type": {
          "type": "string",
          "enum": [
            "function",
            "mcp",
            "skill",
            "subagent",
            "shell",
            "http",
            "datastore"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "description": "The application's grouping of tools, e.g. an MCP server name."
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "ObservingRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "trigger_source",
            "trigger_type",
            "trigger_description",
            "trigger_payload_summary"
          ],
          "properties": {
            "behavior": {
              "const": "Observing"
            },
            "trigger_source": {
              "type": "string",
              "minLength": 1,
              "description": "Prefer a stable URI-like name, e.g. 'claude-code://user_prompt', 'arena://fixtures/<code>/window_open'."
            },
            "trigger_type": {
              "type": "string",
              "enum": [
                "signal_trigger",
                "cron_trigger",
                "human_trigger",
                "outcome_trigger",
                "agent_trigger"
              ],
              "description": "signal = a system event; cron = a schedule; human = a person's message or action; outcome = the result of an earlier action (settlement, test result, revert); agent = another agent or a parent harness."
            },
            "event_ts_utc": {
              "$ref": "#/$defs/EpochMs"
            },
            "trigger_description": {
              "type": "string",
              "minLength": 1
            },
            "trigger_payload_summary": {
              "type": "string",
              "maxLength": 4096
            },
            "trigger_payload": {
              "$ref": "#/$defs/ContentRef",
              "description": "The trigger's payload itself (a person's message, the event's content), in the content library. `trigger_payload_summary` stays the short form."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ToolCallingRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "tool_meta",
            "input_payload",
            "output_payload",
            "outcome"
          ],
          "properties": {
            "behavior": {
              "const": "ToolCalling"
            },
            "tool_meta": {
              "$ref": "#/$defs/ToolMeta"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "effect": {
              "type": "string",
              "enum": [
                "read",
                "write",
                "execute"
              ],
              "description": "What the call did to the world: read only, changed state, or ran something."
            },
            "input_payload": {
              "$ref": "#/$defs/ContentRef"
            },
            "output_payload": {
              "$ref": "#/$defs/ContentRef"
            },
            "outcome": {
              "$ref": "#/$defs/Outcome",
              "description": "Result of the call."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "PlanningRecord": {
      "description": "An explicit, ordered plan for the work ahead, or a revision of an earlier plan: the goal, the steps and what to do if they fail. A vague intention inside a thought is Thinking.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "goal",
            "steps"
          ],
          "properties": {
            "behavior": {
              "const": "Planning"
            },
            "goal": {
              "type": "string",
              "minLength": 1,
              "description": "What the plan is for."
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlanningStep"
              },
              "description": "The ordered steps; may be empty when the plan is only a goal."
            },
            "contingencies": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "What to do when a step fails or an assumption does not hold."
            },
            "revision_of": {
              "$ref": "#/$defs/UuidV4",
              "description": "The earlier Planning record this plan revises."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThinkingRecord": {
      "description": "A deliberate reasoning step inside the cycle: analysis, option comparison, a decision. An explicit, ordered plan is a Planning record.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "output_payload"
          ],
          "properties": {
            "behavior": {
              "const": "Thinking"
            },
            "prompt": {
              "$ref": "#/$defs/ContentRef"
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ThinkingInput"
              }
            },
            "output_payload": {
              "$ref": "#/$defs/ContentRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ActingRecord": {
      "description": "The terminal commitment of a cycle: handing the result over or writing it back. Side effects along the way are ToolCalling.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "action_type",
            "target_system",
            "action_summary",
            "execution_status",
            "outcome"
          ],
          "properties": {
            "behavior": {
              "const": "Acting"
            },
            "action_type": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
              "description": "Namespaced '<domain>.<verb>', e.g. prediction.submit, order.fill, answer.final, git.commit, stage.conclude."
            },
            "target_system": {
              "type": "string",
              "minLength": 1
            },
            "action_summary": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "additionalProperties": true
            },
            "execution_id": {
              "type": "string"
            },
            "execution_status": {
              "type": "string",
              "enum": [
                "confirmed",
                "failed",
                "simulated",
                "pending",
                "cancelled"
              ]
            },
            "outcome": {
              "$ref": "#/$defs/Outcome"
            },
            "output_payload": {
              "$ref": "#/$defs/ContentRef",
              "description": "What was handed over or written back (the final answer, the submitted object), in the content library. `action_summary` stays the short form."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "target_system": {
                    "const": "public-chain"
                  },
                  "execution_status": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "target_system",
                  "execution_status"
                ]
              },
              "then": {
                "required": [
                  "execution_id"
                ]
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "ReflectingRecord": {
      "description": "The agent's evaluation of its own earlier behavior, during the cycle (record_phase concurrent: a test run read, a check) or after it (post_execution: a settlement, a retrospective).",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "inputs",
            "output_payload"
          ],
          "properties": {
            "behavior": {
              "const": "Reflecting"
            },
            "kind": {
              "type": "string",
              "enum": [
                "process",
                "evaluation",
                "settlement"
              ],
              "description": "process = reviewing how it worked; evaluation = judging the output against criteria; settlement = an external result coming back."
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ReflectingInput"
              }
            },
            "output_payload": {
              "$ref": "#/$defs/ContentRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "AttestingRecord": {
      "description": "A person's disposition of a pending item, submitted by the upper-layer application on the person's behalf. Answers an Escalating record when there is one (listed in upstream_record_id).",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "executor",
            "operator_id",
            "disposition",
            "gate_kind",
            "written_by",
            "outcome"
          ],
          "properties": {
            "behavior": {
              "const": "Attesting"
            },
            "executor": {
              "const": "human"
            },
            "operator_id": {
              "type": "string",
              "minLength": 1,
              "description": "The person who made the disposition."
            },
            "disposition": {
              "type": "string",
              "enum": [
                "approve",
                "reject",
                "edit",
                "cancel",
                "no_response"
              ],
              "description": "approve = accepted as proposed; edit = changed it; reject = refused; cancel = the person stopped the pending item; no_response = nobody answered (headless, or the wait ran out)."
            },
            "decision": {
              "description": "Structured decision content: the value the person chose or entered. Shape declared by the upper-layer application."
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "description": "Required when disposition is reject."
            },
            "patch": {
              "type": "object",
              "additionalProperties": true,
              "description": "Changes to the original parameters when disposition is edit."
            },
            "seen_digest": {
              "type": "string",
              "minLength": 1,
              "description": "Digest of what the person saw when deciding."
            },
            "seen_completeness": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "unknown"
              ],
              "description": "Whether what the person saw covered everything the decision depended on."
            },
            "channel": {
              "type": "string",
              "enum": [
                "interactive",
                "async",
                "headless"
              ],
              "description": "interactive = the person was present; async = handled later from a queue; headless = no person could answer."
            },
            "gate_kind": {
              "type": "string",
              "minLength": 1,
              "description": "Checkpoint type, defined by the upper-layer application; starting registry: column, plan, permission, question, deploy."
            },
            "policy_snapshot": {
              "type": "object",
              "additionalProperties": true,
              "description": "Policy in force at the time, or a content reference to it."
            },
            "effects": {
              "$ref": "#/$defs/ContentRef",
              "description": "Side effects of the disposition in the upper-layer application, e.g. configuration or rule changes."
            },
            "written_by": {
              "$ref": "#/$defs/WrittenBy"
            },
            "outcome": {
              "$ref": "#/$defs/Outcome",
              "description": "success = a disposition was recorded; timeout = no_response; cancelled = cancel."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "disposition": {
                    "const": "reject"
                  }
                },
                "required": [
                  "disposition"
                ]
              },
              "then": {
                "required": [
                  "reason"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "disposition": {
                    "const": "no_response"
                  }
                },
                "required": [
                  "disposition"
                ]
              },
              "then": {
                "properties": {
                  "outcome": {
                    "const": "timeout"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "disposition": {
                    "const": "cancel"
                  }
                },
                "required": [
                  "disposition"
                ]
              },
              "then": {
                "properties": {
                  "outcome": {
                    "const": "cancelled"
                  }
                }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "EscalatingRecord": {
      "description": "The agent hands a decision to a person: a question, a permission request, a plan to approve, or giving up and handing the work over. The person's disposition is a separate Attesting record.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "kind",
            "asked",
            "outcome"
          ],
          "properties": {
            "behavior": {
              "const": "Escalating"
            },
            "kind": {
              "type": "string",
              "enum": [
                "question",
                "permission",
                "plan",
                "handoff"
              ]
            },
            "asked": {
              "$ref": "#/$defs/ContentRef",
              "description": "What was put to the person."
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 32
            },
            "default": {
              "type": "string",
              "description": "The option proposed as default, if any."
            },
            "outcome": {
              "$ref": "#/$defs/Outcome",
              "description": "success = a person disposed of it; timeout = nobody answered; cancelled = withdrawn."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DelegatingRecord": {
      "description": "The agent hands a goal to another agent: spawning a sub-agent, handing the work off, or messaging another agent. The delegate's own cycle lives in its own session.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "kind",
            "goal",
            "outcome"
          ],
          "properties": {
            "behavior": {
              "const": "Delegating"
            },
            "kind": {
              "type": "string",
              "enum": [
                "spawn",
                "handoff",
                "message"
              ]
            },
            "goal": {
              "$ref": "#/$defs/ContentRef",
              "description": "What the delegate was asked to do."
            },
            "delegate_agent_id": {
              "type": "string",
              "minLength": 1,
              "description": "The delegate's agent id when it has one, else its type or name."
            },
            "child_session_id": {
              "type": "string",
              "minLength": 1,
              "description": "The session that holds the delegate's own records."
            },
            "awaited": {
              "type": "boolean",
              "description": "Whether this agent waited for the result."
            },
            "result": {
              "$ref": "#/$defs/ContentRef",
              "description": "What came back."
            },
            "outcome": {
              "$ref": "#/$defs/Outcome"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "MemorizingRecord": {
      "description": "A write to state that outlives the cycle: memory, standing rules, skills, settings, a knowledge base. Reading such state is ToolCalling.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "scope",
            "target",
            "op",
            "outcome"
          ],
          "properties": {
            "behavior": {
              "const": "Memorizing"
            },
            "scope": {
              "type": "string",
              "enum": [
                "session",
                "project",
                "user",
                "customer",
                "org",
                "global"
              ],
              "description": "How far the written state reaches."
            },
            "target": {
              "$ref": "#/$defs/ContentRef",
              "description": "What was written: the content, with its location in notes or tags if needed."
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "update",
                "delete"
              ]
            },
            "approved_by": {
              "$ref": "#/$defs/UuidV4",
              "description": "The Attesting record of the person who confirmed this write, when one did."
            },
            "outcome": {
              "$ref": "#/$defs/Outcome"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "OtherRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "behavior",
            "label",
            "data"
          ],
          "properties": {
            "behavior": {
              "const": "Other"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "object",
              "additionalProperties": true
            },
            "proposed_behavior": {
              "type": "string",
              "minLength": 1,
              "description": "The behavior the writer thinks this should be, if the taxonomy lacked it."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Record": {
      "oneOf": [
        {
          "$ref": "#/$defs/ObservingRecord"
        },
        {
          "$ref": "#/$defs/ToolCallingRecord"
        },
        {
          "$ref": "#/$defs/PlanningRecord"
        },
        {
          "$ref": "#/$defs/ThinkingRecord"
        },
        {
          "$ref": "#/$defs/ActingRecord"
        },
        {
          "$ref": "#/$defs/ReflectingRecord"
        },
        {
          "$ref": "#/$defs/AttestingRecord"
        },
        {
          "$ref": "#/$defs/EscalatingRecord"
        },
        {
          "$ref": "#/$defs/DelegatingRecord"
        },
        {
          "$ref": "#/$defs/MemorizingRecord"
        },
        {
          "$ref": "#/$defs/OtherRecord"
        }
      ],
      "discriminator": {
        "propertyName": "behavior",
        "mapping": {
          "Observing": "#/$defs/ObservingRecord",
          "ToolCalling": "#/$defs/ToolCallingRecord",
          "Planning": "#/$defs/PlanningRecord",
          "Thinking": "#/$defs/ThinkingRecord",
          "Acting": "#/$defs/ActingRecord",
          "Reflecting": "#/$defs/ReflectingRecord",
          "Attesting": "#/$defs/AttestingRecord",
          "Escalating": "#/$defs/EscalatingRecord",
          "Delegating": "#/$defs/DelegatingRecord",
          "Memorizing": "#/$defs/MemorizingRecord",
          "Other": "#/$defs/OtherRecord"
        }
      }
    }
  },
  "$ref": "#/$defs/Record"
}
