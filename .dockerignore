# Build context is the repo root; keep heavy/host-only paths out of the image.
**/node_modules
**/dist
**/.astro
**/*.tsbuildinfo
**/.env
**/.env.*
.git
.github
.claude
.vscode
**/__pycache__
**/.venv
python-sdk
*.log
# Local content stores. The image creates /app/data itself, empty, and makes
# api-server/data point at it.
data
api-server/data
