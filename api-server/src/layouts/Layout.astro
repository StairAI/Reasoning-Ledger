---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Reasoning Ledger" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink font-mono antialiased">
    <slot />
  </body>
</html>
