---
import Layout from "#/layouts/Layout.astro";
import ConversationCard from "#/components/ConversationCard.astro";
import Icon from "#/components/Icon.astro";
import ViewerBadge from "#/components/ViewerBadge.astro";
import { buildConversations } from "#/lib/conversations";
import type { Conversation } from "#/lib/conversations";
import { ownedLinks, ownedSessionSummaries } from "#/lib/repository";

export const prerender = false;

// Set by src/middleware.ts from the visitor's login session: one owner, or
// the administrator, who sees every owner's traces.
const {viewer} = Astro.locals;
const admin = viewer?.admin ?? false;

// Each turn of a chat harness is its own trace; the list groups them into
// conversations and nests the ones another conversation started or forked.
let conversations: Conversation[] = [];
let traceCount = 0;
let loadError: string | null = null;
try {
  const scope = viewer?.ownerId ?? null;
  const [sessions, links] = await Promise.all([ownedSessionSummaries(scope, 500), ownedLinks(scope)]);
  traceCount = sessions.length;
  conversations = buildConversations(sessions, links);
} catch (error) {
  loadError = error instanceof Error ? error.message : "Failed to load traces";
}
---

<Layout title="Reasoning Ledger · Traces">
  <div class="min-h-screen dot-grid">
    <div class="mx-auto flex max-w-[960px] flex-col gap-8 px-6 py-16">
      <!-- header -->
      <header class="flex flex-col gap-2">
        <div class="flex items-center gap-2 text-ink/50">
          <Icon name="git-fork" size={16} />
          <span class="font-sans text-[13px] uppercase tracking-wider">Reasoning Ledger</span>
          <ViewerBadge viewer={viewer} />
          <form method="post" action="/logout" class="ml-auto">
            <button type="submit" class="text-[12px] text-ink/50 hover:text-ink">Sign out</button>
          </form>
        </div>
        <h1 class="font-sans text-[28px] font-medium text-ink">Reasoning Traces</h1>
        <p class="text-[13px] text-ink/50">
          {`${conversations.length} ${conversations.length === 1 ? "conversation" : "conversations"} · ${traceCount} ${traceCount === 1 ? "trace" : "traces"} · click a turn to open its reasoning digraph`}
        </p>
      </header>

      {
        loadError && (
          <div class="rounded-lg border border-[#e06c7f]/40 bg-[#e06c7f]/10 p-4 text-[12px] text-[#e06c7f]">
            {loadError}
          </div>
        )
      }

      {
        !loadError && conversations.length === 0 && (
          <div class="rounded-lg border border-line bg-surface/60 p-8 text-center text-[13px] text-ink/50">
            No reasoning traces recorded yet.
          </div>
        )
      }

      <!-- conversation list -->
      <ul class="flex flex-col gap-3">
        {conversations.map((c) => <ConversationCard admin={admin} conversation={c} />)}
      </ul>
    </div>
  </div>
</Layout>
