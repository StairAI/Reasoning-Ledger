---
import Icon from "./Icon.astro";
import { BEHAVIOR_META, LEGEND_ORDER } from "#/lib/trace";

const COLOR: Record<string, string> = {
  acting: "#00b2a4",
  observing: "#ebb447",
  other: "#9a9a9a",
  planning: "#7ee055",
  reflecting: "#e06c7f",
  thinking: "#bf80ff",
  toolcalling: "#3c9add",
};
---

<div
  class="flex w-60 flex-wrap gap-2 rounded-lg border border-line bg-black/40 p-4 backdrop-blur-sm"
>
  {
    LEGEND_ORDER.map((b) => {
      const meta = BEHAVIOR_META[b];
      return (
        <div class="flex w-24 items-center gap-1">
          <span style={`color:${COLOR[meta.token]}`}>
            <Icon name={meta.icon} size={12} />
          </span>
          <span class="text-[12px] text-ink">{meta.label}</span>
        </div>
      );
    })
  }
</div>
