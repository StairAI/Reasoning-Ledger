---
import Icon from "./Icon.astro";
import StatusTag from "./StatusTag.astro";
import { behaviorMeta, depIds, formatFull, highlightJSON, overviewSections, payloadOnly } from '#/lib/trace';
import type { TraceRecord } from '#/lib/trace';

interface Props {
  record: TraceRecord;
  /** Whether this panel is the initially-visible one. */
  active?: boolean;
}

const { record, active = false } = Astro.props;
const meta = behaviorMeta(record.behavior);
const sections = overviewSections(record);
const deps = depIds(record);
const payload = payloadOnly(record);

const COLOR: Record<string, string> = {
  acting: "#00b2a4",
  observing: "#ebb447",
  other: "#9a9a9a",
  planning: "#7ee055",
  reflecting: "#e06c7f",
  thinking: "#bf80ff",
  toolcalling: "#3c9add",
};
const tc = COLOR[meta.token] ?? COLOR.other;
---

<section
  class="inspector-panel flex h-full w-[320px] flex-col overflow-hidden rounded-lg border border-line bg-surface/95 backdrop-blur-sm"
  style={`--tc:${tc}`}
  data-inspector
  data-record-id={record.record_id}
  hidden={!active}
>
  <!-- title bar -->
  <header class="flex shrink-0 items-center justify-between border-b border-line p-4">
    <div class="flex items-center gap-2" style={`color:${tc}`}>
      <Icon name={meta.icon} size={16} />
      <span class="font-sans text-[14px] font-medium text-ink">{record.behavior}</span>
    </div>
    <button
      type="button"
      class="text-ink/30 transition-colors hover:text-ink/80"
      data-inspector-close
      aria-label="Close"
    >
      <Icon name="x" size={16} />
    </button>
  </header>

  <!-- body -->
  <div class="thin-scroll flex flex-col gap-6 overflow-y-auto p-4">
    <!-- info -->
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-1.5">
        <span class="text-[12px] text-ink/60">{record.record_id}</span>
        <button
          type="button"
          class="text-ink/40 transition-colors hover:text-ink/80"
          data-copy={record.record_id}
          aria-label="Copy record id"
        >
          <Icon name="copy" size={12} />
        </button>
      </div>
      <div class="flex flex-col gap-1 text-[12px] uppercase leading-5 text-ink/90">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="folder" size={12} />
          {record.session_id}
        </span>
        <span class="text-ink/55">· {formatFull(record.client_ts_utc)}</span>
      </div>
    </div>

    <!-- tabs -->
    <div class="flex flex-col gap-6">
      <nav class="flex h-6 items-start gap-4 border-b border-line" data-tabs>
        <button type="button" class="tab-btn" data-tab="overview" data-active={active}>Overview</button>
        <button type="button" class="tab-btn" data-tab="payload">Payload</button>
        <button type="button" class="tab-btn inline-flex items-center gap-1" data-tab="deps">
          Deps
          <span class="flex size-4 items-center justify-center rounded-sm bg-surface-2 text-[11px] text-ink/60">
            {deps.length}
          </span>
        </button>
        <button type="button" class="tab-btn" data-tab="raw">Raw</button>
      </nav>

      <!-- Overview -->
      <div class="flex flex-col gap-6" data-tabpanel="overview">
        {
          sections.map((s) => (
            <div class="flex w-full flex-col gap-2">
              <p class="text-[11px] uppercase text-ink/40">{s.label}</p>
              {s.kind === "rows" && (
                <div class="flex flex-col gap-1 text-[12px]">
                  {s.rows.length === 0 && <span class="text-ink/40">—</span>}
                  {s.rows.map(([k, v]) => (
                    <div class="flex items-start justify-between gap-4">
                      <span class="font-sans text-ink/60">{k}</span>
                      <span class="text-right font-sans text-ink">{v}</span>
                    </div>
                  ))}
                </div>
              )}
              {s.kind === "text" && (
                <p class="whitespace-pre-wrap break-words font-sans text-[12px] text-ink/90">
                  {s.text || "—"}
                </p>
              )}
              {s.kind === "code" && (
                <pre
                  class="thin-scroll overflow-x-auto rounded-sm bg-surface-2 px-3 py-2 text-[11px] leading-[18px] text-ink/80"
                  set:html={highlightJSON(s.value)}
                />
              )}
              {s.kind === "status" && s.status && (
                <StatusTag label={s.status.label} kind={s.status.kind} />
              )}
            </div>
          ))
        }
      </div>

      <!-- Payload -->
      <div class="flex flex-col gap-2" data-tabpanel="payload" hidden>
        <pre
          class="thin-scroll overflow-x-auto rounded-sm bg-surface-2 px-3 py-2 text-[11px] leading-[18px] text-ink/80"
          set:html={highlightJSON(payload)}
        />
      </div>

      <!-- Deps -->
      <div class="flex flex-col gap-2" data-tabpanel="deps" hidden>
        {deps.length === 0 && <span class="text-[12px] text-ink/40">No dependencies</span>}
        {
          deps.map((id) => (
            <button
              type="button"
              class="flex items-center gap-2 rounded-sm border border-line bg-surface-2/40 px-2 py-1.5 text-left text-[12px] text-ink/80 transition-colors hover:border-line-strong"
              data-dep={id}
            >
              <Icon name="git-fork" size={12} />
              <span class="truncate">{id}</span>
            </button>
          ))
        }
      </div>

      <!-- Raw -->
      <div class="flex flex-col gap-2" data-tabpanel="raw" hidden>
        <pre
          class="thin-scroll overflow-x-auto rounded-sm bg-surface-2 px-3 py-2 text-[11px] leading-[18px] text-ink/80"
          set:html={highlightJSON(record)}
        />
      </div>
    </div>
  </div>
</section>
